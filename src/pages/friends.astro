---
// Public friends page: what your friends have been up to lately, then links to their shelves.
// Only their PUBLIC entries are shown here; friends-only items stay in Manage → Friends.
import Base from '../layouts/Base.astro';
import '../styles/filters.css';
import CopyLink from '../components/CopyLink.astro';
import { friendsFeed } from '../../server/federation/index.js';
import { fmtDate } from '../lib/items.js';
import { TYPES, STATUS_LABEL, stars } from '../lib/types.js';

const env = Astro.locals.runtime.env;
let friends = [], items = [];
try { ({ friends, items } = await friendsFeed(env, { limit: 240 })); } catch {}
const PAGE = 12; // cards shown at first and per "Load more"
const who = (f) => f.owner || f.name || f.url.replace(/^https?:\/\//, '');
// Filters only offer choices that would narrow the list.
const feedFriends = friends.filter((f) => items.some((i) => i.friend.url === f.url));
const feedTypes = Object.keys(TYPES).filter((t) => items.some((i) => (i.type || 'book') === t));
const groups = [];
if (feedFriends.length > 1) groups.push({ key: 'friend', label: 'Friend', options: feedFriends.map((f) => [f.url, who(f)]) });
if (feedTypes.length > 1) groups.push({ key: 'type', label: 'Media', options: feedTypes.map((t) => [t, TYPES[t].plural]) });
const host = (u) => u.replace(/^https?:\/\//, '');
---
<Base title="Friends">
  <section class="page-head">
    <p class="eyebrow">{friends.length} {friends.length === 1 ? 'friend' : 'friends'}</p>
    <h1>Friends<CopyLink /></h1>
  </section>

  {friends.length === 0 ? (
    <p class="shelf-empty">No friends yet.</p>
  ) : (
    <>
      <section class="friends-feed">
        <h2>Lately</h2>
        {items.length === 0 && <p class="shelf-empty">Nothing new from friends yet.</p>}
        {groups.length > 0 && (
          <div class="bg-filters feed-filters" aria-label="Filter">
            <div class="bgf-body">
              {groups.map((g) => (
                <div class="bgf-group">
                  <span class="bgf-label">{g.label}</span>
                  <div class="bgf-chips" data-filter={g.key}>
                    <button type="button" class="bgf-chip on" data-value="" aria-pressed="true">All</button>
                    {g.options.map(([v, l]) => <button type="button" class="bgf-chip" data-value={v} aria-pressed="false">{l}</button>)}
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
        <ul class="feed-list" id="feed-list" data-page={PAGE}>
          {items.map((i, n) => {
            const t = TYPES[i.type] || TYPES.book;
            const link = i.url || i.friend.url;
            return (
              <li class="feed-row" data-friend={i.friend.url} data-type={i.type || 'book'} data-uid={i.uid} data-title={i.title} hidden={n >= PAGE}>
                <a class="feed-cover" href={link} target="_blank" rel="noopener" style={`--tc:${t.color}; aspect-ratio:${t.aspect}`}>
                  {i.cover ? <img src={i.cover} alt="" loading="lazy" referrerpolicy="no-referrer" /> : <span>{(i.title || '?').slice(0, 1)}</span>}
                </a>
                <div class="feed-text">
                  <p class="eyebrow"><a href={i.friend.url} target="_blank" rel="noopener">{who(i.friend)}</a> · {STATUS_LABEL(i.type, i.status)}{i.date && <> · {fmtDate(i.date)}</>}</p>
                  <h3><a href={link} target="_blank" rel="noopener">{i.title}</a> {i.rating != null && <span class="rating">{stars(i.rating)}</span>}</h3>
                  <p class="creator">{t.label}{i.creator && <> · {i.creator}</>}{i.year && <> · {i.year}</>}</p>
                </div>
                {/* Shown by the script below only to you, when you're signed in on this device. */}
                <button type="button" class="heart-btn" aria-pressed="false" title="I enjoyed this too" hidden>
                  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-9.3-9.2C1.4 8 3.4 4.5 7 4.5c2 0 3.3 1.1 5 3 1.7-1.9 3-3 5-3 3.6 0 5.6 3.5 4.3 6.8-1.8 4.6-9.3 9.2-9.3 9.2z"/></svg>
                </button>
              </li>
            );
          })}
        </ul>
        <p class="shelf-empty" id="feed-none" hidden>Nothing here yet.</p>
        <p class="heart-msg" id="heart-msg" role="status" hidden></p>
        <div class="feed-more" id="feed-more" hidden={items.length <= PAGE}>
          <button type="button" class="btn-see-all" id="feed-more-btn">Load more</button>
        </div>
      </section>

      <section class="friends-shelves">
        <h2>Their shelves</h2>
        <ul class="friend-cards">
          {friends.map((f) => (
            <li>
              <a class="friend-card" href={f.url} target="_blank" rel="noopener">
                <span class="friend-initial" aria-hidden="true">{who(f).slice(0, 1).toUpperCase()}</span>
                <span class="friend-card-text">
                  <strong>{who(f)}</strong>
                  <span>{f.owner && f.name ? `${f.name} · ` : ''}{host(f.url)}</span>
                </span>
                <span class="friend-go" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </>
  )}
</Base>

<script>
  // "Lately": show 12 cards, "Load more" adds 12 more, and the Friend / Media chips narrow the list.
  const list = document.getElementById('feed-list');
  if (list) {
    const page = Number(list.dataset.page) || 12;
    const rows = [...list.querySelectorAll('.feed-row')];
    const more = document.getElementById('feed-more');
    const none = document.getElementById('feed-none');
    const state = { friend: '', type: '' };
    let shown = page;
    const render = () => {
      const match = rows.filter((r) => (!state.friend || r.dataset.friend === state.friend) && (!state.type || r.dataset.type === state.type));
      rows.forEach((r) => { r.hidden = true; });
      match.slice(0, shown).forEach((r) => { r.hidden = false; });
      more.hidden = match.length <= shown;
      none.hidden = match.length > 0 || rows.length === 0;
    };
    document.getElementById('feed-more-btn')?.addEventListener('click', () => { shown += page; render(); });
    document.querySelectorAll('.feed-filters .bgf-chips').forEach((group) => {
      group.addEventListener('click', (e) => {
        const chip = e.target.closest('.bgf-chip');
        if (!chip) return;
        state[group.dataset.filter] = chip.dataset.value;
        group.querySelectorAll('.bgf-chip').forEach((c) => {
          const on = c === chip;
          c.classList.toggle('on', on);
          c.setAttribute('aria-pressed', String(on));
        });
        shown = page; // a new filter starts back at the first 12
        render();
      });
    });
  }

  // Hearts ("I enjoyed this too"): only for you. This page is public, so the buttons stay hidden unless
  // this browser is signed in to Manage, and which items you've hearted is fetched with your token.
  (async () => {
    let token = '';
    try { token = localStorage.getItem('myshelf_token') || ''; } catch {}
    const rows = [...document.querySelectorAll('.feed-row[data-uid]')];
    if (!token || !rows.length) return;
    const api = (body) => fetch('/api/friends' + (body ? '' : '?hearts=1'), {
      method: body ? 'POST' : 'GET',
      headers: { authorization: `Bearer ${token}`, ...(body ? { 'content-type': 'application/json' } : {}) },
      body: body ? JSON.stringify(body) : undefined,
    });
    let hearts;
    try {
      const res = await api();
      if (!res.ok) return; // not signed in (or an old token): leave the page as everyone sees it
      ({ hearts } = await res.json());
    } catch { return; }
    const on = new Set(hearts.map((h) => `${h.friendUrl} ${h.uid}`));
    const msg = document.getElementById('heart-msg');
    let msgTimer;
    const say = (text, error = false) => {
      msg.textContent = text;
      msg.classList.toggle('error', error);
      msg.hidden = false;
      clearTimeout(msgTimer);
      msgTimer = setTimeout(() => (msg.hidden = true), error ? 7000 : 3500);
    };
    const set = (btn, yes) => {
      btn.classList.toggle('on', yes);
      btn.setAttribute('aria-pressed', String(yes));
      btn.title = yes ? 'You enjoyed this too (click to undo)' : 'I enjoyed this too';
    };
    for (const row of rows) {
      const btn = row.querySelector('.heart-btn');
      set(btn, on.has(`${row.dataset.friend} ${row.dataset.uid}`));
      btn.hidden = false;
      btn.addEventListener('click', async () => {
        const yes = !btn.classList.contains('on');
        btn.disabled = true;
        try {
          const res = await api({ action: 'heart', friendUrl: row.dataset.friend, uid: row.dataset.uid, title: row.dataset.title, on: yes });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || `Couldn’t send (${res.status})`);
          set(btn, yes);
          btn.classList.toggle('pop', yes);
          if (yes) say('Sent. They’ll see you enjoyed it too.');
        } catch (err) {
          say(err.message, true);
        } finally {
          btn.disabled = false;
        }
      });
    }
  })();
</script>

<style>
  .friends-feed, .friends-shelves { margin: 8px 0 36px; }
  .friends-feed h2, .friends-shelves h2 { font-size: 1.3rem; margin: 0 0 12px; }
  @media (min-width: 761px) { .feed-filters .bgf-label { width: 64px; } }
  .feed-row[hidden] { display: none; }
  .feed-more { display: flex; justify-content: center; margin-top: 18px; }
  .feed-more[hidden] { display: none; }
  .feed-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .feed-row { display: flex; gap: 16px; align-items: center; padding: 14px 16px; border-radius: 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(241,230,208,0.08); }
  .feed-cover { flex: 0 0 auto; height: 84px; display: grid; place-items: center; border-radius: 4px; overflow: hidden; background: var(--tc); color: #fbf6ec; font-weight: 700; text-decoration: none; box-shadow: 0 6px 14px rgba(0,0,0,0.35); }
  .feed-cover img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .feed-text { min-width: 0; }
  .feed-text .eyebrow { margin: 0 0 4px; }
  .feed-text h3 { margin: 0; font-size: 1.05rem; }
  .feed-text h3 a { text-decoration: none; }
  .feed-text h3 a:hover { color: var(--accent); }
  .feed-text .rating { color: var(--accent); font-size: 0.9rem; margin-left: 4px; }
  .feed-text .creator { margin: 2px 0 0; color: var(--cream-soft); font-size: 0.88rem; }
  .heart-btn { flex: 0 0 auto; margin-left: auto; display: grid; place-items: center; width: 40px; height: 40px; padding: 0; border-radius: 50%; cursor: pointer; background: transparent; border: 1px solid rgba(241,230,208,0.18); color: var(--cream-soft); transition: color 0.15s, border-color 0.15s; }
  .heart-btn[hidden] { display: none; }
  .heart-btn svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linejoin: round; }
  .heart-btn:hover, .heart-btn.on { color: var(--accent); border-color: var(--accent); }
  .heart-btn.on svg { fill: currentColor; }
  .heart-btn.pop { animation: heart-pop 0.25s ease-out; }
  .heart-btn:disabled { opacity: 0.6; cursor: wait; }
  @keyframes heart-pop { 50% { transform: scale(1.2); } }
  @media (prefers-reduced-motion: reduce) { .heart-btn.pop { animation: none; } }
  .heart-msg { position: fixed; left: 50%; bottom: 24px; transform: translateX(-50%); z-index: 50; margin: 0; padding: 10px 16px; border-radius: 10px; background: #1d1d1f; border: 1px solid var(--accent); color: var(--cream); font-size: 0.9rem; box-shadow: 0 8px 24px rgba(0,0,0,0.45); }
  .heart-msg.error { border-color: #d9534f; }
  .heart-msg[hidden] { display: none; }
  .friend-cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .friend-card { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border-radius: 14px; text-decoration: none; background: rgba(255,255,255,0.04); border: 1px solid rgba(241,230,208,0.1); transition: border-color 0.15s; }
  .friend-card:hover { border-color: var(--accent); }
  .friend-initial { width: 40px; height: 40px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 50%; background: rgba(217,154,78,0.18); color: var(--accent); font-weight: 700; }
  .friend-card-text { display: flex; flex-direction: column; min-width: 0; }
  .friend-card-text span { color: var(--cream-soft); font-size: 0.85rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .friend-go { margin-left: auto; color: var(--accent); }
</style>
